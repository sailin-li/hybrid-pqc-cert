+static int test_client_configuration_rejections(void)
+{
+	static const uint8_t psk[32] = { 1 };
+	TLS_CTX ctx;
+	TLS_CONNECT conn;
+
+	CHECK(init_pqpsk_client(&ctx, &conn, psk, sizeof(psk)) == 1);
+	conn.early_data = 1;
+	CHECK(tls13_send_client_hello(&conn) == -1);
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+
+	CHECK(init_pqpsk_client(&ctx, &conn, psk, sizeof(psk)) == 1);
+	conn.key_exchange_modes &= ~TLS_KE_PSK_DHE;
+	CHECK(tls13_send_client_hello(&conn) == -1);
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+
+	CHECK(init_pqpsk_client(&ctx, &conn, psk, sizeof(psk)) == 1);
+	conn.key_share = 0;
+	CHECK(tls13_send_client_hello(&conn) == -1);
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+
+	CHECK(init_pqpsk_client(&ctx, &conn, psk, sizeof(psk)) == 1);
+	conn.pre_shared_key = 0;
+	CHECK(tls13_send_client_hello(&conn) == -1);
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+
+	CHECK(init_pqpsk_client(&ctx, &conn, psk, sizeof(psk)) == 1);
+	conn.psk_identity_types[0] = TLS13_PSK_IDENTITY_RESUMPTION;
+	CHECK(tls13_send_client_hello(&conn) == -1);
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+
+	printf("%s() ok\n", __FUNCTION__);
+	return 1;
+}
+
+
+typedef struct {
+	uint8_t early_secret[32];
+	uint8_t handshake_secret[32];
+	uint8_t master_secret[32];
+	uint8_t application_secret[32];
+} TEST_SECRETS;
+
+
+static int derive_test_secrets(const uint8_t psk[32],
+	const uint8_t ecdhe[32], TEST_SECRETS *secrets)
+{
+	static const uint8_t transcript[] = "ClientHello || ServerHello";
+	const uint8_t zeros[32] = {0};
+	uint8_t derived[32];
+	DIGEST_CTX empty_ctx;
+	DIGEST_CTX transcript_ctx;
+	const DIGEST *digest = DIGEST_sm3();
+
+	if (digest_init(&empty_ctx, digest) != 1
+		|| digest_init(&transcript_ctx, digest) != 1
+		|| digest_update(&transcript_ctx, transcript, sizeof(transcript) - 1) != 1
+		|| tls13_hkdf_extract(digest, zeros, psk, secrets->early_secret) != 1
+		|| tls13_derive_secret(secrets->early_secret, "derived",
+			&empty_ctx, derived) != 1
+		|| tls13_hkdf_extract(digest, derived, ecdhe,
+			secrets->handshake_secret) != 1
+		|| tls13_derive_secret(secrets->handshake_secret, "derived",
+			&empty_ctx, secrets->master_secret) != 1
+		|| tls13_hkdf_extract(digest, secrets->master_secret, zeros,
+			secrets->master_secret) != 1
+		|| tls13_derive_secret(secrets->master_secret, "s ap traffic",
+			&transcript_ctx, secrets->application_secret) != 1) {
+		gmssl_secure_clear(derived, sizeof(derived));
+		error_print();
+		return -1;
+	}
+	gmssl_secure_clear(derived, sizeof(derived));
+	return 1;
+}
+
+
+static int test_psk_and_ecdhe_enter_key_schedule(void)
+{
+	uint8_t psk_a[32] = { 0x11 };
+	uint8_t psk_b[32] = { 0x22 };
+	uint8_t ecdhe_a[32] = { 0x33 };
+	uint8_t ecdhe_b[32] = { 0x44 };
+	TEST_SECRETS aa;
+	TEST_SECRETS ba;
+	TEST_SECRETS ab;
+
+	CHECK(derive_test_secrets(psk_a, ecdhe_a, &aa) == 1);
+	CHECK(derive_test_secrets(psk_b, ecdhe_a, &ba) == 1);
+	CHECK(derive_test_secrets(psk_a, ecdhe_b, &ab) == 1);
+	CHECK(memcmp(aa.early_secret, ba.early_secret, 32) != 0);
+	CHECK(memcmp(aa.handshake_secret, ba.handshake_secret, 32) != 0);
+	CHECK(memcmp(aa.master_secret, ba.master_secret, 32) != 0);
+	CHECK(memcmp(aa.application_secret, ba.application_secret, 32) != 0);
+	CHECK(memcmp(aa.early_secret, ab.early_secret, 32) == 0);
+	CHECK(memcmp(aa.handshake_secret, ab.handshake_secret, 32) != 0);
+	CHECK(memcmp(aa.master_secret, ab.master_secret, 32) != 0);
+	CHECK(memcmp(aa.application_secret, ab.application_secret, 32) != 0);
+
+	gmssl_secure_clear(&aa, sizeof(aa));
+	gmssl_secure_clear(&ba, sizeof(ba));
+	gmssl_secure_clear(&ab, sizeof(ab));
+	gmssl_secure_clear(psk_a, sizeof(psk_a));
+	gmssl_secure_clear(psk_b, sizeof(psk_b));
+	gmssl_secure_clear(ecdhe_a, sizeof(ecdhe_a));
+	gmssl_secure_clear(ecdhe_b, sizeof(ecdhe_b));
+	printf("%s() ok\n", __FUNCTION__);
+	return 1;
+}
+
+
+static int test_certificate_verify_tamper(void)
+{
+	static const uint8_t transcript[] = "0xFF03 authenticated transcript";
+	SM2_KEY sm2_key;
+	X509_KEY x509_key;
+	DIGEST_CTX transcript_ctx;
+	uint8_t sig[SM2_MAX_SIGNATURE_SIZE];
+	size_t siglen = 0;
+
+	memset(&sm2_key, 0, sizeof(sm2_key));
+	memset(&x509_key, 0, sizeof(x509_key));
+	CHECK(sm2_key_generate(&sm2_key) == 1);
+	CHECK(x509_key_set_sm2_key(&x509_key, &sm2_key) == 1);
+	CHECK(digest_init(&transcript_ctx, DIGEST_sm3()) == 1);
+	CHECK(digest_update(&transcript_ctx, transcript,
+		sizeof(transcript) - 1) == 1);
+	CHECK(tls13_sign_certificate_verify(TLS_server_mode, TLS_sig_sm2sig_sm3,
+		&x509_key, &transcript_ctx, sig, &siglen) == 1);
+	CHECK(tls13_verify_certificate_verify(TLS_server_mode, TLS_sig_sm2sig_sm3,
+		&x509_key, &transcript_ctx, sig, siglen) == 1);
+	sig[siglen - 1] ^= 0x01;
+	CHECK(tls13_verify_certificate_verify(TLS_server_mode, TLS_sig_sm2sig_sm3,
+		&x509_key, &transcript_ctx, sig, siglen) != 1);
+
+	gmssl_secure_clear(sig, sizeof(sig));
+	x509_key_cleanup(&x509_key);
+	gmssl_secure_clear(&sm2_key, sizeof(sm2_key));
+	printf("%s() ok\n", __FUNCTION__);
+	return 1;
+}
+
+
+int main(void)
+{
+	if (test_post_quantum_pre_shared_key_wire() != 1
+#ifndef WIN32
+		|| test_client_hello_extensions() != 1
+		|| test_external_psk_binder_tamper() != 1
+		|| test_malformed_client_hello_rejections() != 1
+		|| test_unsolicited_server_hello_extension() != 1
+		|| test_illegal_message_and_missing_certificate() != 1
+#endif
+		|| test_client_configuration_rejections() != 1
+		|| test_psk_and_ecdhe_enter_key_schedule() != 1
+		|| test_certificate_verify_tamper() != 1) {
+		return 1;
+	}
+	printf("%s all tests passed\n", __FILE__);
+	return 0;
+}
