+static int find_client_hello_extension(uint8_t *record, int wanted_type,
+	uint8_t **wanted_data, size_t *wanted_datalen)
+{
+	int legacy_version;
+	const uint8_t *random;
+	const uint8_t *session_id;
+	size_t session_id_len;
+	const uint8_t *cipher_suites;
+	size_t cipher_suites_len;
+	const uint8_t *exts;
+	size_t exts_len;
+
+	if (tls_record_get_handshake_client_hello(record,
+		&legacy_version, &random, &session_id, &session_id_len,
+		&cipher_suites, &cipher_suites_len, &exts, &exts_len) != 1) {
+		error_print();
+		return -1;
+	}
+	while (exts_len) {
+		int ext_type;
+		const uint8_t *ext_data;
+		size_t ext_datalen;
+
+		if (tls_ext_from_bytes(&ext_type, &ext_data, &ext_datalen,
+			&exts, &exts_len) != 1) {
+			error_print();
+			return -1;
+		}
+		if (ext_type == wanted_type) {
+			*wanted_data = (uint8_t *)ext_data;
+			*wanted_datalen = ext_datalen;
+			return 1;
+		}
+	}
+	return 0;
+}
