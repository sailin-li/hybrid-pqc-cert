+static int test_malformed_client_hello_rejections(void)
+{
+	static const uint8_t psk[32] = { 0x5a };
+	static const enum CLIENT_HELLO_MUTATION mutations[] = {
+		REMOVE_SUPPORTED_GROUPS,
+		REMOVE_KEY_SHARE,
+		REMOVE_PSK_MODES,
+		REMOVE_PRE_SHARED_KEY,
+		PRE_SHARED_KEY_NOT_LAST,
+		ADD_EARLY_DATA,
+		PSK_KE_ONLY,
+		DUPLICATE_PQPSK,
+		NONEMPTY_PQPSK,
+	};
+	uint8_t source[TLS_MAX_RECORD_SIZE];
+	uint8_t record[TLS_MAX_RECORD_SIZE];
+	size_t source_len = 0;
+	size_t recordlen;
+	size_t i;
+
+	CHECK(generate_pqpsk_client_hello(psk, source, &source_len) == 1);
+	for (i = 0; i < sizeof(mutations)/sizeof(mutations[0]); i++) {
+		CHECK(mutate_client_hello(source, record, &recordlen,
+			mutations[i]) == 1);
+		CHECK(server_rejects_client_hello(record, recordlen, psk) == 1);
+	}
+	gmssl_secure_clear(source, sizeof(source));
+	gmssl_secure_clear(record, sizeof(record));
+	printf("%s() ok\n", __FUNCTION__);
+	return 1;
+}
