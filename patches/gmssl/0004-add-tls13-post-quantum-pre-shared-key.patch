+static int init_pqpsk_client(TLS_CTX *ctx, TLS_CONNECT *conn,
+	const uint8_t *psk, size_t psk_len)
+{
+	static const int cipher_suites[] = { TLS_cipher_sm4_gcm_sm3 };
+	static const int groups[] = { TLS_curve_sm2p256v1 };
+	static const int sig_algs[] = { TLS_sig_sm2sig_sm3 };
+	static const uint8_t identity[] = "pqpsk-test";
+
+	memset(ctx, 0, sizeof(*ctx));
+	memset(conn, 0, sizeof(*conn));
+	if (tls_ctx_init(ctx, TLS_protocol_tls13, TLS_client_mode) != 1
+		|| tls_ctx_set_cipher_suites(ctx, cipher_suites,
+			sizeof(cipher_suites)/sizeof(cipher_suites[0])) != 1
+		|| tls_ctx_set_supported_groups(ctx, groups,
+			sizeof(groups)/sizeof(groups[0])) != 1
+		|| tls_ctx_set_signature_algorithms(ctx, sig_algs,
+			sizeof(sig_algs)/sizeof(sig_algs[0])) != 1
+		|| tls13_ctx_set_psk_key_exchange_modes(ctx, 0, 1) != 1
+		|| tls13_ctx_enable_post_quantum_pre_shared_key(ctx, 1) != 1
+		|| tls_init(conn, ctx) != 1
+		|| tls13_add_pre_shared_key(conn, identity, sizeof(identity) - 1,
+			psk, psk_len, TLS_cipher_sm4_gcm_sm3, 0) != 1
+		|| tls13_enable_pre_shared_key(conn, 1) != 1) {
+		error_print();
+		tls_cleanup(conn);
+		tls_ctx_cleanup(ctx);
+		return -1;
+	}
+	return 1;
+}
