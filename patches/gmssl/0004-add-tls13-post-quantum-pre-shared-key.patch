+static int test_external_psk_binder_tamper(void)
+{
+	static const uint8_t psk[32] = {
+		0x00,0x01,0x02,0x03,0x04,0x05,0x06,0x07,
+		0x08,0x09,0x0a,0x0b,0x0c,0x0d,0x0e,0x0f,
+		0x10,0x11,0x12,0x13,0x14,0x15,0x16,0x17,
+		0x18,0x19,0x1a,0x1b,0x1c,0x1d,0x1e,0x1f,
+	};
+	uint8_t record[TLS_MAX_RECORD_SIZE];
+	size_t recordlen = 0;
+	uint8_t *pre_shared_key;
+	size_t pre_shared_key_len;
+	const uint8_t *identities;
+	size_t identities_len;
+	const uint8_t *binders;
+	size_t binders_len;
+	const uint8_t *binder;
+	size_t binder_len;
+	TLS_CTX ctx;
+	TLS_CONNECT conn;
+
+	CHECK(generate_pqpsk_client_hello(psk, record, &recordlen) == 1);
+	CHECK(find_client_hello_extension(record, TLS_extension_pre_shared_key,
+		&pre_shared_key, &pre_shared_key_len) == 1);
+	CHECK(tls13_client_pre_shared_key_from_bytes(&identities, &identities_len,
+		&binders, &binders_len, pre_shared_key, pre_shared_key_len) == 1);
+	CHECK(tls_uint8array_from_bytes(&binder, &binder_len,
+		&binders, &binders_len) == 1);
+	CHECK(binder_len == 32);
+
+	CHECK(init_pqpsk_server(&ctx, &conn, psk) == 1);
+	memcpy(conn.record, record, recordlen);
+	conn.recordlen = recordlen;
+	CHECK(find_client_hello_extension(conn.record, TLS_extension_pre_shared_key,
+		&pre_shared_key, &pre_shared_key_len) == 1);
+	CHECK(tls13_process_client_pre_shared_key_external(&conn,
+		pre_shared_key, pre_shared_key_len) == 1);
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+
+	/* The first byte after the binder's uint8 length is binder data. */
+	((uint8_t *)binder)[0] ^= 0x01;
+	CHECK(init_pqpsk_server(&ctx, &conn, psk) == 1);
+	memcpy(conn.record, record, recordlen);
+	conn.recordlen = recordlen;
+	CHECK(find_client_hello_extension(conn.record, TLS_extension_pre_shared_key,
+		&pre_shared_key, &pre_shared_key_len) == 1);
+	CHECK(tls13_process_client_pre_shared_key_external(&conn,
+		pre_shared_key, pre_shared_key_len) == -1);
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+
+	gmssl_secure_clear(record, sizeof(record));
+	printf("%s() ok\n", __FUNCTION__);
+	return 1;
+}
