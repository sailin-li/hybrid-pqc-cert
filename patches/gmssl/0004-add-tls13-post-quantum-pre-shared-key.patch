+static int test_post_quantum_pre_shared_key_wire(void)
+{
+	static const uint8_t expected[] = { 0xff, 0x03, 0x00, 0x00 };
+	static const uint8_t nonempty[] = { 0x00 };
+	uint8_t buf[8];
+	uint8_t *p = buf;
+	const uint8_t *cp = buf;
+	const uint8_t *ext_data;
+	size_t len = 0;
+	size_t ext_datalen;
+	int ext_type;
+
+	CHECK(tls13_post_quantum_pre_shared_key_ext_to_bytes(&p, &len) == 1);
+	CHECK(len == sizeof(expected));
+	CHECK(memcmp(buf, expected, sizeof(expected)) == 0);
+	CHECK(tls_ext_from_bytes(&ext_type, &ext_data, &ext_datalen, &cp, &len) == 1);
+	CHECK(ext_type == TLS_extension_post_quantum_pre_shared_key);
+	CHECK(ext_data == NULL);
+	CHECK(ext_datalen == 0);
+	CHECK(len == 0);
+	CHECK(tls13_post_quantum_pre_shared_key_from_bytes(ext_data, ext_datalen) == 1);
+	CHECK(tls13_post_quantum_pre_shared_key_from_bytes(nonempty, sizeof(nonempty)) == -1);
+
+	printf("%s() ok\n", __FUNCTION__);
+	return 1;
+}
