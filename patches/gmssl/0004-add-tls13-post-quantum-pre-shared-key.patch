+/*
+ * post_quantum_pre_shared_key is a project-private experimental TLS 1.3
+ * extension whose behavior is modeled after RFC 9973
+ * tls_cert_with_extern_psk. ExtensionType 0xFF03 is not assigned by IANA.
+ * The extension is an empty flag; PSK identities and binders remain in the
+ * standard pre_shared_key extension.
+ */
+int tls13_post_quantum_pre_shared_key_ext_to_bytes(uint8_t **out, size_t *outlen)
+{
+	if (!out || !*out || !outlen) {
+		error_print();
+		return -1;
+	}
+	return tls_ext_to_bytes(TLS_extension_post_quantum_pre_shared_key,
+		NULL, 0, out, outlen);
+}
+
+int tls13_post_quantum_pre_shared_key_from_bytes(const uint8_t *ext_data,
+	size_t ext_datalen)
+{
+	if (ext_data || ext_datalen) {
+		error_print();
+		return -1;
+	}
+	return 1;
+}
+
+int tls13_ctx_enable_post_quantum_pre_shared_key(TLS_CTX *ctx, int enable)
+{
+	if (!ctx || ctx->protocol != TLS_protocol_tls13) {
+		error_print();
+		return -1;
+	}
+	ctx->post_quantum_pre_shared_key = enable ? 1 : 0;
+	if (!enable) {
+		ctx->require_post_quantum_pre_shared_key = 0;
+	}
+	return 1;
+}
+
+int tls13_ctx_require_post_quantum_pre_shared_key(TLS_CTX *ctx, int require)
+{
+	if (!ctx || ctx->protocol != TLS_protocol_tls13) {
+		error_print();
+		return -1;
+	}
+	ctx->require_post_quantum_pre_shared_key = require ? 1 : 0;
+	if (require) {
+		ctx->post_quantum_pre_shared_key = 1;
+	}
+	return 1;
+}
