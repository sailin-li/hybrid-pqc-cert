+#ifndef WIN32
+static int generate_pqpsk_client_hello(const uint8_t psk[32],
+	uint8_t *record, size_t *recordlen)
+{
+	TLS_CTX ctx;
+	TLS_CONNECT conn;
+	tls_socket_t fds[2] = { -1, -1 };
+	int ret = -1;
+
+	if (!record || !recordlen
+		|| init_pqpsk_client(&ctx, &conn, psk, 32) != 1) {
+		error_print();
+		return -1;
+	}
+	if (socketpair(AF_UNIX, SOCK_STREAM, 0, fds) != 0
+		|| tls_set_socket(&conn, fds[0]) != 1
+		|| tls13_send_client_hello(&conn) != 1
+		|| conn.plain_recordlen > TLS_MAX_RECORD_SIZE) {
+		error_print();
+		goto end;
+	}
+	memcpy(record, conn.plain_record, conn.plain_recordlen);
+	*recordlen = conn.plain_recordlen;
+	ret = 1;
+
+end:
+	if (fds[0] >= 0) {
+		tls_socket_close(fds[0]);
+	}
+	if (fds[1] >= 0) {
+		tls_socket_close(fds[1]);
+	}
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+	return ret;
+}
