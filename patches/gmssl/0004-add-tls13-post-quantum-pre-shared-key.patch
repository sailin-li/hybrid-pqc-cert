+
+		if (tls_ext_from_bytes(&ext_type, &ext_data, &ext_datalen,
+			&exts, &exts_len) != 1) {
+			error_print();
+			goto end;
+		}
+		switch (ext_type) {
+		case TLS_extension_supported_groups:
+			saw_supported_groups++;
+			break;
+		case TLS_extension_key_share:
+			saw_key_share++;
+			break;
+		case TLS_extension_psk_key_exchange_modes:
+			saw_psk_modes++;
+			if (tls13_psk_key_exchange_modes_from_bytes(&psk_modes,
+				ext_data, ext_datalen) != 1) {
+				goto end;
+			}
+			break;
+		case TLS_extension_post_quantum_pre_shared_key:
+			saw_pqpsk++;
+			if (tls13_post_quantum_pre_shared_key_from_bytes(
+				ext_data, ext_datalen) != 1) {
+				goto end;
+			}
+			break;
+		case TLS_extension_pre_shared_key:
+			saw_pre_shared_key++;
+			/* RFC 8446 requires pre_shared_key to be last. */
+			if (exts_len != 0) {
+				goto end;
+			}
+			break;
+		default:
+			break;
+		}
+	}
+	if (legacy_version != TLS_protocol_tls12 || !random || !cipher_suites
+		|| !cipher_suites_len || saw_supported_groups != 1
+		|| saw_key_share != 1 || saw_psk_modes != 1
+		|| !(psk_modes & TLS_KE_PSK_DHE) || saw_pqpsk != 1
+		|| saw_pre_shared_key != 1 || !conn.post_quantum_psk_offered) {
+		error_print();
+		goto end;
+	}
+	ret = 1;
+
+end:
+	if (fds[0] >= 0) {
+		tls_socket_close(fds[0]);
+	}
+	if (fds[1] >= 0) {
+		tls_socket_close(fds[1]);
+	}
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+	if (ret == 1) {
+		printf("%s() ok\n", __FUNCTION__);
+	}
+	return ret;
+}
+
+
+static int protected_server_record_is_rejected(const uint8_t *plain_record,
+	size_t plain_record_len, int (*recv_func)(TLS_CONNECT *))
+{
+	static const uint8_t psk[32] = { 0x3c };
+	static const uint8_t raw_key[16] = { 0x7d };
+	TLS_CTX ctx;
+	TLS_CONNECT conn;
+	tls_socket_t fds[2] = { -1, -1 };
+	uint8_t record[TLS_MAX_RECORD_SIZE];
+	size_t recordlen = 0;
+	int ret = -1;
+
+	if (!plain_record || !plain_record_len || !recv_func
+		|| init_pqpsk_client(&ctx, &conn, psk, sizeof(psk)) != 1) {
+		error_print();
+		return -1;
+	}
+	conn.cipher_suite = TLS_cipher_sm4_gcm_sm3;
+	conn.digest = DIGEST_sm3();
+	conn.post_quantum_psk_negotiated = 1;
+	if (digest_init(&conn.dgst_ctx, conn.digest) != 1
+		|| block_cipher_set_encrypt_key(&conn.server_write_key,
+			BLOCK_CIPHER_sm4(), raw_key) != 1
+		|| tls13_record_encrypt(conn.cipher_suite, &conn.server_write_key,
+			conn.server_write_iv, conn.server_seq_num,
+			plain_record, plain_record_len, 0, record, &recordlen) != 1
+		|| socketpair(AF_UNIX, SOCK_STREAM, 0, fds) != 0
+		|| tls_set_socket(&conn, fds[0]) != 1
+		|| tls_socket_send(fds[1], record, recordlen, 0)
+			!= (tls_ret_t)recordlen) {
+		error_print();
+		goto end;
+	}
+	ret = recv_func(&conn) == -1 ? 1 : -1;
+
+end:
+	if (fds[0] >= 0) {
+		tls_socket_close(fds[0]);
+	}
+	if (fds[1] >= 0) {
+		tls_socket_close(fds[1]);
+	}
+	gmssl_secure_clear(record, sizeof(record));
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+	return ret;
+}
+
+
+static int test_illegal_message_and_missing_certificate(void)
+{
+	uint8_t exts[8];
+	uint8_t *p = exts;
+	size_t extslen = 0;
+	uint8_t record[TLS_MAX_RECORD_SIZE] = {0};
+	size_t recordlen = 0;
+	uint8_t verify_data[32] = {0};
+
+	CHECK(tls13_post_quantum_pre_shared_key_ext_to_bytes(&p, &extslen) == 1);
+	CHECK(tls_record_set_protocol(record, TLS_protocol_tls12) == 1);
+	CHECK(tls13_record_set_handshake_encrypted_extensions(record, &recordlen,
+		exts, extslen) == 1);
+	CHECK(protected_server_record_is_rejected(record, recordlen,
+		tls13_recv_encrypted_extensions) == 1);
+
+	memset(record, 0, sizeof(record));
+	recordlen = 0;
+	CHECK(tls_record_set_protocol(record, TLS_protocol_tls12) == 1);
+	CHECK(tls13_record_set_handshake_finished(record, &recordlen,
+		verify_data, sizeof(verify_data)) == 1);
+	CHECK(protected_server_record_is_rejected(record, recordlen,
+		tls13_recv_server_certificate) == 1);
+
+	gmssl_secure_clear(record, sizeof(record));
+	printf("%s() ok\n", __FUNCTION__);
+	return 1;
+}
+#endif
