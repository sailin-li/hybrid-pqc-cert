+enum CLIENT_HELLO_MUTATION {
+	REMOVE_SUPPORTED_GROUPS,
+	REMOVE_KEY_SHARE,
+	REMOVE_PSK_MODES,
+	REMOVE_PRE_SHARED_KEY,
+	PRE_SHARED_KEY_NOT_LAST,
+	ADD_EARLY_DATA,
+	PSK_KE_ONLY,
+	DUPLICATE_PQPSK,
+	NONEMPTY_PQPSK,
+};
+
+
+static int mutate_client_hello(const uint8_t *source, uint8_t *record,
+	size_t *recordlen, enum CLIENT_HELLO_MUTATION mutation)
+{
+	static const int cipher_suites[] = { TLS_cipher_sm4_gcm_sm3 };
+	int legacy_version;
+	const uint8_t *random;
+	const uint8_t *session_id;
+	size_t session_id_len;
+	const uint8_t *encoded_cipher_suites;
+	size_t encoded_cipher_suites_len;
+	const uint8_t *exts;
+	size_t exts_len;
+	uint8_t new_exts[TLS_MAX_EXTENSIONS_SIZE];
+	uint8_t *p = new_exts;
+	size_t new_exts_len = 0;
+
+	if (tls_record_get_handshake_client_hello(source,
+		&legacy_version, &random, &session_id, &session_id_len,
+		&encoded_cipher_suites, &encoded_cipher_suites_len,
+		&exts, &exts_len) != 1) {
+		error_print();
+		return -1;
+	}
+	while (exts_len) {
+		const uint8_t *raw_ext = exts;
+		int ext_type;
+		const uint8_t *ext_data;
+		size_t ext_datalen;
+		size_t raw_ext_len;
+
+		if (tls_ext_from_bytes(&ext_type, &ext_data, &ext_datalen,
+			&exts, &exts_len) != 1) {
+			error_print();
+			return -1;
+		}
+		raw_ext_len = (size_t)(exts - raw_ext);
+		if ((mutation == REMOVE_SUPPORTED_GROUPS
+				&& ext_type == TLS_extension_supported_groups)
+			|| (mutation == REMOVE_KEY_SHARE
+				&& ext_type == TLS_extension_key_share)
+			|| (mutation == REMOVE_PSK_MODES
+				&& ext_type == TLS_extension_psk_key_exchange_modes)
+			|| (mutation == REMOVE_PRE_SHARED_KEY
+				&& ext_type == TLS_extension_pre_shared_key)) {
+			continue;
+		}
+		if (mutation == NONEMPTY_PQPSK
+			&& ext_type == TLS_extension_post_quantum_pre_shared_key) {
+			const uint8_t nonempty = 0;
+			if (tls_ext_to_bytes(ext_type, &nonempty, sizeof(nonempty),
+				&p, &new_exts_len) != 1) {
+				return -1;
+			}
+			continue;
+		}
+		if (mutation == PSK_KE_ONLY
+			&& ext_type == TLS_extension_psk_key_exchange_modes) {
+			if (tls13_psk_key_exchange_modes_ext_to_bytes(TLS_KE_PSK,
+				&p, &new_exts_len) != 1) {
+				return -1;
+			}
+			continue;
+		}
+		if (ext_type == TLS_extension_pre_shared_key) {
+			if (mutation == ADD_EARLY_DATA
+				&& tls_ext_to_bytes(TLS_extension_early_data,
+					NULL, 0, &p, &new_exts_len) != 1) {
+				return -1;
+			}
+			if (mutation == DUPLICATE_PQPSK
+				&& tls13_post_quantum_pre_shared_key_ext_to_bytes(
+					&p, &new_exts_len) != 1) {
+				return -1;
+			}
+		}
+		memcpy(p, raw_ext, raw_ext_len);
+		p += raw_ext_len;
+		new_exts_len += raw_ext_len;
+		if (mutation == PRE_SHARED_KEY_NOT_LAST
+			&& ext_type == TLS_extension_pre_shared_key
+			&& tls_ext_to_bytes(TLS_extension_post_handshake_auth,
+				NULL, 0, &p, &new_exts_len) != 1) {
+			return -1;
+		}
+	}
+
+	memset(record, 0, TLS_MAX_RECORD_SIZE);
+	*recordlen = 0;
+	if (tls_record_set_protocol(record, TLS_protocol_tls1) != 1) {
+		return -1;
+	}
+	return tls_record_set_handshake_client_hello(record, recordlen,
+		legacy_version, random, session_id, session_id_len,
+		cipher_suites, sizeof(cipher_suites)/sizeof(cipher_suites[0]),
+		new_exts, new_exts_len);
+}
+
+
+static int server_rejects_client_hello(const uint8_t *record, size_t recordlen,
+	const uint8_t psk[32])
+{
+	TLS_CTX ctx;
+	TLS_CONNECT conn;
+	tls_socket_t fds[2] = { -1, -1 };
+	int ret = -1;
+
+	if (init_pqpsk_server(&ctx, &conn, psk) != 1) {
+		return -1;
+	}
+	if (socketpair(AF_UNIX, SOCK_STREAM, 0, fds) != 0
+		|| tls_set_socket(&conn, fds[1]) != 1
+		|| tls_socket_send(fds[0], record, recordlen, 0) != (tls_ret_t)recordlen) {
+		error_print();
+		goto end;
+	}
+	ret = tls13_recv_client_hello(&conn) == -1 ? 1 : -1;
+
+end:
+	if (fds[0] >= 0) {
+		tls_socket_close(fds[0]);
+	}
+	if (fds[1] >= 0) {
+		tls_socket_close(fds[1]);
+	}
+	tls_cleanup(&conn);
+	tls_ctx_cleanup(&ctx);
+	return ret;
+}
