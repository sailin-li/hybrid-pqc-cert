diff --git a/src/tls_ext.c b/src/tls_ext.c
index f5e4de00..088eaa22 100644
--- a/src/tls_ext.c
+++ b/src/tls_ext.c
@@ -62,6 +62,138 @@ int tls_ext_from_bytes(int *type, const uint8_t **data, size_t *datalen, const u
 	return 1;
 }
 
+int tls_ctx_set_pqkex_kems(TLS_CTX *ctx, const uint16_t *kems, size_t kems_cnt)
+{
+	size_t i;
+
+	if (!ctx || ctx->protocol != TLS_protocol_tlcp || !kems
+		|| !kems_cnt || kems_cnt > TLS_PQKEX_MAX_KEMS) {
+		error_print();
+		return -1;
+	}
+	for (i = 0; i < kems_cnt; i++) {
+		if (kems[i] != TLS_PQKEX_KEM_MLKEM768) {
+			error_print();
+			return -1;
+		}
+	}
+	memcpy(ctx->pqkex_kems, kems, kems_cnt * sizeof(kems[0]));
+	ctx->pqkex_kems_cnt = kems_cnt;
+	return 1;
+}
+
+int tls_pqkex_ext_to_bytes(const uint16_t *kems, size_t kems_cnt,
+	uint8_t **out, size_t *outlen)
+{
+	uint8_t ext_data[2 + TLS_PQKEX_MAX_KEMS * 2];
+	uint8_t *p = ext_data;
+	size_t ext_datalen = 0;
+	size_t i;
+
+	if (!kems || !kems_cnt || kems_cnt > TLS_PQKEX_MAX_KEMS || !outlen) {
+		error_print();
+		return -1;
+	}
+	tls_uint16_to_bytes((uint16_t)(kems_cnt * 2), &p, &ext_datalen);
+	for (i = 0; i < kems_cnt; i++) {
+		tls_uint16_to_bytes(kems[i], &p, &ext_datalen);
+	}
+	return tls_ext_to_bytes(TLS_extension_pqkex, ext_data, ext_datalen,
+		out, outlen);
+}
+
+int tls_pqkex_from_bytes(uint16_t *kems, size_t *kems_cnt, size_t max_kems,
+	const uint8_t *ext_data, size_t ext_datalen)
+{
+	const uint8_t *list;
+	size_t list_len;
+	size_t count;
+	size_t i;
+
+	if (!kems || !kems_cnt || !max_kems || max_kems > TLS_PQKEX_MAX_KEMS
+		|| !ext_data) {
+		error_print();
+		return -1;
+	}
+	*kems_cnt = 0;
+	if (tls_uint16array_from_bytes(&list, &list_len, &ext_data, &ext_datalen) != 1
+		|| ext_datalen != 0 || list_len < 2 || (list_len & 1)) {
+		error_print();
+		return -1;
+	}
+	count = list_len / 2;
+	if (count > max_kems) {
+		error_print();
+		return -1;
+	}
+	for (i = 0; i < count; i++) {
+		if (tls_uint16_from_bytes(&kems[i], &list, &list_len) != 1) {
+			error_print();
+			return -1;
+		}
+	}
+	if (list_len != 0) {
+		error_print();
+		return -1;
+	}
+	*kems_cnt = count;
+	return 1;
+}
+
+int tls_pqkex_select_kem(const uint16_t *client_kems, size_t client_kems_cnt,
+	const uint16_t *server_kems, size_t server_kems_cnt, uint16_t *selected_kem)
+{
+	size_t i;
+	size_t j;
+
+	if (!selected_kem || !client_kems || !client_kems_cnt
+		|| client_kems_cnt > TLS_PQKEX_MAX_KEMS
+		|| (!server_kems && server_kems_cnt)
+		|| server_kems_cnt > TLS_PQKEX_MAX_KEMS) {
+		error_print();
+		return -1;
+	}
+	*selected_kem = TLS_PQKEX_KEM_NONE;
+	for (i = 0; i < client_kems_cnt; i++) {
+		for (j = 0; j < server_kems_cnt; j++) {
+			if (client_kems[i] == server_kems[j]) {
+				*selected_kem = client_kems[i];
+				return 1;
+			}
+		}
+	}
+	return 0;
+}
+
+int tlcp_process_client_pqkex(TLS_CONNECT *conn,
+	const uint8_t *ext_data, size_t ext_datalen)
+{
+	uint16_t client_kems[TLS_PQKEX_MAX_KEMS];
+	size_t client_kems_cnt = 0;
+	int ret;
+
+	if (!conn || !conn->ctx || conn->protocol != TLS_protocol_tlcp
+		|| conn->pqkex_offered) {
+		error_print();
+		return -1;
+	}
+	if (tls_pqkex_from_bytes(client_kems, &client_kems_cnt,
+		TLS_PQKEX_MAX_KEMS, ext_data, ext_datalen) != 1) {
+		error_print();
+		return -1;
+	}
+	ret = tls_pqkex_select_kem(client_kems, client_kems_cnt,
+		conn->ctx->pqkex_kems, conn->ctx->pqkex_kems_cnt,
+		&conn->pqkex_selected_kem);
+	if (ret < 0) {
+		error_print();
+		return -1;
+	}
+	conn->pqkex_offered = 1;
+	conn->pqkex_negotiated = (ret == 1);
+	return 1;
+}
+
