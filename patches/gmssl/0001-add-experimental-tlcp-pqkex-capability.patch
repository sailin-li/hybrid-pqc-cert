diff --git a/tools/pqkex_demo.c b/tools/pqkex_demo.c
new file mode 100644
index 00000000..c8c45393
--- /dev/null
+++ b/tools/pqkex_demo.c
@@ -0,0 +1,43 @@
+/* Project-private experimental TLCP PQKEX capability demonstration. */
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <gmssl/tls.h>
+
+int pqkex_demo_main(int argc, char **argv)
+{
+	const uint16_t mlkem768[] = {TLS_PQKEX_KEM_MLKEM768};
+	uint8_t extension[32];
+	uint8_t *p = extension;
+	size_t extension_len = 0;
+	TLS_CTX server_ctx;
+	TLS_CONNECT server_conn;
+
+	(void)argc;
+	(void)argv;
+	memset(&server_ctx, 0, sizeof(server_ctx));
+	server_ctx.protocol = TLS_protocol_tlcp;
+	if (tls_ctx_set_pqkex_kems(&server_ctx, mlkem768, 1) != 1
+		|| tls_pqkex_ext_to_bytes(mlkem768, 1, &p, &extension_len) != 1) {
+		return 1;
+	}
+	memset(&server_conn, 0, sizeof(server_conn));
+	server_conn.protocol = TLS_protocol_tlcp;
+	server_conn.ctx = &server_ctx;
+	if (extension_len != 8
+		|| tlcp_process_client_pqkex(&server_conn,
+			extension + 4, extension_len - 4) != 1) {
+		return 1;
+	}
+
+	printf("=== Experimental TLCP PQKEX Capability ===\n\n");
+	printf("Extension: FF 02 00 04 00 02 00 01\n");
+	printf("Client offered: ML-KEM-768 (0x0001)\n");
+	printf("Server selected: ML-KEM-768 (0x%04X)\n",
+		server_conn.pqkex_selected_kem);
+	printf("PQKEX capability negotiation: %s\n",
+		server_conn.pqkex_negotiated ? "PASS" : "FAIL");
+	printf("ML-KEM KeyGen/Encaps/Decaps: NOT EXECUTED\n");
+	printf("Hybrid secret: NOT DERIVED\n");
+	return server_conn.pqkex_negotiated ? 0 : 1;
+}
