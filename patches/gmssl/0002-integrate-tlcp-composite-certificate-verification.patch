+static int tlcp_hybrid_certs_from_pem(uint8_t *certs, size_t *certslen,
+	size_t maxlen, FILE *fp)
+{
+	int ret;
+	size_t certlen;
+
+	*certslen = 0;
+	for (;;) {
+		const uint8_t *cursor;
+		size_t remaining;
+		const uint8_t *certificate;
+		size_t certificate_len;
+
+		ret = pem_read(fp, "CERTIFICATE", certs, &certlen, maxlen);
+		if (ret < 0) {
+			error_print();
+			return -1;
+		}
+		if (ret == 0) {
+			break;
+		}
+		cursor = certs;
+		remaining = certlen;
+		if (remaining == 0 || *cursor != ASN1_TAG_SEQUENCE
+			|| asn1_any_from_der(&certificate, &certificate_len,
+				&cursor, &remaining) != 1
+			|| remaining != 0) {
+			error_print();
+			return -1;
+		}
+		certs += certlen;
+		*certslen += certlen;
+		maxlen -= certlen;
+	}
+	return *certslen ? 1 : 0;
+}
