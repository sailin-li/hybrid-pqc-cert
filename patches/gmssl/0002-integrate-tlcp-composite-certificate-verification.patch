+static int tls_raw_certificate_from_der(const uint8_t **cert, size_t *certlen,
+	const uint8_t **in, size_t *inlen)
+{
+	if (!cert || !certlen || !in || !*in || !inlen || !*inlen
+		|| **in != ASN1_TAG_SEQUENCE
+		|| asn1_any_from_der(cert, certlen, in, inlen) != 1) {
+		error_print();
+		return -1;
+	}
+	return 1;
+}
+
+int tls_cert_chain_get_cert_by_index_raw(const uint8_t *certs,
+	size_t certslen, int index, const uint8_t **cert, size_t *certlen)
+{
+	int current = 0;
+
+	if (!certs || !certslen || index < 0 || !cert || !certlen) {
+		error_print();
+		return -1;
+	}
+	while (certslen) {
+		if (tls_raw_certificate_from_der(cert, certlen,
+			&certs, &certslen) != 1) {
+			return -1;
+		}
+		if (current++ == index) {
+			return 1;
+		}
+	}
+	*cert = NULL;
+	*certlen = 0;
+	return 0;
+}
